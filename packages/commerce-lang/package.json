{
  "name": "@warp-lang/commerce-lang",
  "version": "0.8.0",
  "description": "A focused syntax for AUTHORING the current Warp Commerce Model \u2014 parse a .warp file into a commitment lifecycle, profile, and auction (market-making: AuctionProcess + Tendered commitments) and compile it to the exact structures the model already uses. Adds no new semantics; the compiled output is checked by the same guard and temporal verifier.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "GRAMMAR.md",
    "README.md",
    "CHANGELOG.md",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "node examples/lang.mjs",
    "example:auction": "node examples/lang-auction.mjs",
    "example:policy": "node examples/lang-policy.mjs",
    "example:system": "node examples/system.mjs",
    "example:auction-run": "node examples/auction-run.mjs",
    "example:derived": "node examples/derived.mjs",
    "example:composed": "node examples/composed.mjs",
    "deploy": "node ../../scripts/deploy-flow.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "commerce",
    "warp",
    "dsl",
    "parser",
    "compiler",
    "state-machine",
    "lifecycle",
    "auction",
    "market-making",
    "formal-methods"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasirlts/warp-lang",
    "directory": "packages/commerce-lang"
  },
  "homepage": "https://github.com/yasirlts/warp-lang",
  "dependencies": {
    "@warp-lang/commerce-types": "file:../commerce-types"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "warpc": "./bin/warpc.mjs"
  }
}
